// Ember backend — Prisma schema
//
// Design notes (see docs/ember/OPEN_DECISIONS.md for the full rationale):
// - IDs are UUIDs generated by the database (gen_random_uuid()), not app-generated,
//   so uniqueness holds even under concurrent writes from multiple app instances.
// - Soft deletes (`deletedAt`) are used where a record must remain referenceable after
//   a user-facing "delete" action (Users, Profiles, Messages) to preserve integrity of
//   related records (a deleted user's messages shouldn't vanish from the other party's
//   conversation) and to support the data-retention rules in docs/ember/DATABASE_SCHEMA.md.
// - Hard deletes are used where soft-delete has no privacy benefit (RefreshToken, Session).
// - AuditLog is intentionally append-only at the application layer; see SECURITY_NOTES.md
//   for the follow-up needed to also enforce that at the database-role level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique // "user" | "moderator" | "admin" | "support"
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique // e.g. "reports.read", "users.ban", "moderation.resolve"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

model Users {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  dateOfBirth  DateTime?  @db.Date
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles         UserRole[]
  profile       Profile?
  preferences   Preferences?
  sessions      Session[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  subscriptions Subscription[]

  likesSent        Like[]         @relation("LikeActor")
  likesReceived    Like[]         @relation("LikeTarget")
  matchesAsUserA   Match[]        @relation("MatchUserA")
  matchesAsUserB   Match[]        @relation("MatchUserB")
  messagesSent     Message[]      @relation("MessageSender")
  reportsFiled     Report[]       @relation("ReportReporter")
  reportsReceived  Report[]       @relation("ReportSubject")
  blocksCreated    Block[]        @relation("BlockBlocker")
  blocksReceived   Block[]        @relation("BlockBlocked")
  moderationCases  ModerationCase[] @relation("ModerationSubject")
  moderatedCases   ModerationCase[] @relation("ModerationAssignee")
  auditLogEntries  AuditLog[]     @relation("AuditActor")

  @@index([status])
  @@map("users")
}

model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  user            Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique // SHA-256 of the raw refresh token — the raw value is never stored
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenHash String?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────────────────────────

enum Intent {
  CASUAL
  SERIOUS
  FRIENDSHIP
}

model Profile {
  userId      String    @id @db.Uuid
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  intent      Intent?
  city        String?
  region      String?
  country     String?

  verifiedBadge Boolean @default(false)
  visible       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photos        Photo[]
  promptAnswers PromptAnswer[]

  @@map("profiles")
}

model Photo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  storageKey        String // provider-agnostic object storage reference (see StorageProvider interface)
  moderationStatus  PhotoModerationStatus @default(PENDING)
  isPrimary         Boolean @default(false)
  blurredUntilMatch Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("photos")
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PromptAnswer {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String  @db.Uuid
  profile    Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  promptKey  String
  answer     String

  @@unique([profileId, promptKey])
  @@map("prompt_answers")
}

model Preferences {
  userId       String @id @db.Uuid
  user         Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageMin       Int    @default(18)
  ageMax       Int    @default(99)
  maxDistanceKm Int   @default(50)
  seekingGenders String[] // free-form list, validated at the application layer
  verifiedOnly Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("preferences")
}

// ─────────────────────────────────────────────────────────────
// MATCHING
// ─────────────────────────────────────────────────────────────

enum LikeAction {
  LIKE
  PASS
  SUPER_LIKE
}

model Like {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId  String     @db.Uuid
  actor    Users      @relation("LikeActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId String     @db.Uuid
  target   Users      @relation("LikeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  action   LikeAction
  createdAt DateTime  @default(now())

  @@unique([actorId, targetId]) // one decision per pair; changing your mind updates the row, not a new one
  @@index([targetId, action])
  @@map("likes")
}

model Match {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId  String   @db.Uuid
  userA    Users    @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId  String   @db.Uuid
  userB    Users    @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  matchedAt   DateTime  @default(now())
  unmatchedAt DateTime?

  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("matches")
}

// ─────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────

model Conversation {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId String @unique @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  messages Message[]

  @@map("conversations")
}

enum MessageKind {
  TEXT
  VOICE
  SYSTEM
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?      @db.Uuid // null for SYSTEM messages
  sender         Users?       @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  kind         MessageKind @default(TEXT)
  body         String?
  mediaStorageKey String?

  sentAt    DateTime  @default(now())
  deletedAt DateTime?

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// TRUST & SAFETY
// ─────────────────────────────────────────────────────────────

enum ReportReason {
  HARASSMENT
  SCAM_OR_FRAUD
  FAKE_PROFILE
  UNDERAGE_CONCERN
  INAPPROPRIATE_CONTENT
  OFF_PLATFORM_SOLICITATION
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String       @db.Uuid
  reporter   Users        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subjectId  String       @db.Uuid
  subject    Users        @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  reason  ReportReason
  details String?
  status  ReportStatus @default(OPEN)

  moderationCaseId String?         @db.Uuid
  moderationCase   ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([subjectId])
  @@map("reports")
}

model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @db.Uuid
  blocker   Users    @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   Users    @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ACTION_TAKEN
  DISMISSED
}

enum ModerationAction {
  NONE
  WARNING
  CONTENT_REMOVED
  SUSPENDED
  BANNED
}

model ModerationCase {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId   String                @db.Uuid
  subject     Users                 @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  assigneeId  String?               @db.Uuid
  assignee    Users?                @relation("ModerationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  status      ModerationCaseStatus  @default(OPEN)
  action      ModerationAction      @default(NONE)
  notes       String?
  automated   Boolean               @default(false) // true if opened by an automated signal rather than a user report

  reports     Report[]

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([subjectId])
  @@map("moderation_cases")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG (append-only — see SECURITY_NOTES.md)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @db.Uuid // null for system-initiated actions
  actor     Users?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "auth.login", "moderation.ban_user", "report.create"
  subjectId String?  @db.Uuid // the record acted upon, when applicable — not a FK, since the subject can be any table
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTIONS (Stripe extension point — see integrations/payments)
// ─────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  PLUS
  GOLD
  BLACK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   SubscriptionTier   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  externalProviderRef String? // e.g. Stripe subscription ID once billing is configured
  currentPeriodEnd    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS (push/email extension point)
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  NEW_MATCH
  NEW_MESSAGE
  NEW_LIKE
  SAFETY_ALERT
  SYSTEM
}

model Notification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  payload Json?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
