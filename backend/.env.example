# Copy to .env and fill in real values for local development.
# Never commit a real .env file — see ../.gitignore.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string. See DEPLOYMENT.md for local setup instructions.
DATABASE_URL="postgresql://ember:CHANGE_ME@127.0.0.1:5432/ember_dev?schema=public"

# JWT signing secret for access tokens. Generate a real random value per environment —
# never reuse this placeholder outside of local development.
JWT_ACCESS_SECRET="CHANGE_ME_use_a_long_random_value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Allowed origin(s) for the web client.
CORS_ORIGIN="http://localhost:5173"

# Rate limiting (see SECURITY_NOTES.md).
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="100"

# ── Extension points — unset by default. See src/integrations/README.md. ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# AWS_REGION=
# AWS_S3_BUCKET=
# IDENTITY_VERIFICATION_PROVIDER=
# IDENTITY_VERIFICATION_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# PUSH_PROVIDER=
# ANALYTICS_WRITE_KEY=
