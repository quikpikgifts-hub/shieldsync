# Copy to .env and fill in real values for local development.
# Never commit a real .env file — see ../.gitignore.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string. See DEPLOYMENT.md for local setup instructions.
DATABASE_URL="postgresql://ember:CHANGE_ME@127.0.0.1:5432/ember_dev?schema=public"

# JWT signing secret for access tokens. Generate a real random value per environment —
# never reuse this placeholder outside of local development. Minimum 32 characters,
# enforced at boot (see src/config/validation.schema.ts and SECURITY_AUDIT.md L-2).
JWT_ACCESS_SECRET="CHANGE_ME_use_a_long_random_value_at_least_32_characters"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Allowed origin(s) for the web client — comma-separated, no spaces around commas needed.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Used to build links inside transactional emails (verification, password reset).
FRONTEND_BASE_URL="http://localhost:5173"

# Rate limiting (see SECURITY_NOTES.md).
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="100"
# The login/password-reset-request endpoints use a separate, stricter limit.
LOGIN_THROTTLE_TTL_MS="60000"
LOGIN_THROTTLE_LIMIT="5"

# Per-account login lockout, independent of the IP-based throttle above
# (SECURITY_AUDIT.md H-2). Keyed on the submitted email string itself.
LOGIN_LOCKOUT_THRESHOLD="10"
LOGIN_LOCKOUT_WINDOW_MINUTES="15"
LOGIN_LOCKOUT_DURATION_MINUTES="15"

# ── Redis — optional. Unset means distributed rate limiting, account lockout, the token
# blacklist, and background job queues (email sending, thumbnail generation) all fall back
# to an in-memory/direct equivalent. Fine for local dev/a single instance; required for a
# real multi-instance production deployment. See PRODUCTION_READINESS.md. ──
# REDIS_URL="redis://127.0.0.1:6379/0"

# ── SMTP — optional. Unset means no verification/password-reset/security-alert emails are
# sent (NotificationEmailService logs a warning and skips instead of failing the request).
# Works with any SMTP-speaking provider (Postmark, SES's SMTP interface, SendGrid, etc.),
# not just a self-hosted relay. ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=no-reply@ember.example.com
# EMAIL_FROM_NAME=Ember

# ── Object storage — optional. Unset means photo upload doesn't actually work end-to-end
# (see OPEN_DECISIONS.md D-05) — StorageProvider resolves to a NotConfigured stub that
# throws. Works against real AWS S3 (omit S3_ENDPOINT) or any S3-compatible service
# (MinIO, DigitalOcean Spaces, etc. — set S3_ENDPOINT and S3_FORCE_PATH_STYLE=true). ──
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Error tracking — optional. Unset means unhandled exceptions are only logged locally,
# not reported to a vendor dashboard. ──
# SENTRY_DSN=

# Structured log level.
LOG_LEVEL="info"

# Health-check memory thresholds (see src/health/health.controller.ts) — tune to the
# actual memory limit of wherever this is deployed.
# HEALTH_HEAP_THRESHOLD_MB=1024
# HEALTH_RSS_THRESHOLD_MB=1536

# ── Extension points that still throw until a real adapter is written — see
# src/integrations/README.md. Unset by default. ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# IDENTITY_VERIFICATION_PROVIDER=
# IDENTITY_VERIFICATION_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PUSH_PROVIDER=
# ANALYTICS_WRITE_KEY=
